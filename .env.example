# Frontend — plantilla de variables de entorno para desarrollo local
# Copia este archivo como ".env" dentro de la carpeta client/ y ajusta los valores.
# El archivo ".env" real está en el .gitignore y NUNCA se sube al repositorio.
#
# Para Docker, la variable la inyecta el docker-compose desde el .env raíz
# (VITE_API_URL=/api) y se hornea en el bundle durante el build.

# URL base de la API del backend
# Desarrollo local (backend corriendo en puerto 8080):
VITE_API_URL=http://localhost:8081/api
# Docker (nginx proxía /api → backend:8080, sin exponer el puerto directamente):
# VITE_API_URL=/api
